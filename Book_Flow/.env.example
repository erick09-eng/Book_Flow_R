# Variables públicas (se exponen al cliente via import.meta.env)
# Copia este archivo a .env.local y completa los valores
# NO subas .env.local a Git

# Google OAuth (inicio de sesión con Google)
VITE_GOOGLE_CLIENT_ID=tu_google_client_id.apps.googleusercontent.com

# Supabase (clase 4 - reseñas)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=tu_clave_anonima_supabase
VITE_TABLA_RESENAS=reviews

